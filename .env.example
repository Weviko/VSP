# ── Database ──────────────────────────────────────────
POSTGRES_USER=vsp
POSTGRES_PASSWORD=vsp_dev_pw
POSTGRES_DB=vsp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vsp:vsp_dev_pw@localhost:5432/vsp

# ── Object storage (S3 compatible) ────────────────────
MINIO_USER=vspadmin
MINIO_PASSWORD=vsp_dev_pw_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=vsp

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change_me_in_production
# 배포된 두 앱의 공개 URL(상호 링크용). 배포 후 실제 주소로 채운다.
# VSP_PORTAL_URL=https://<portal>.vercel.app
# VSP_PLATFORM_URL=https://<platform>.vercel.app

# ── 데모 배포(미리보기) 전용 로그인 ───────────────────
# DEMO_LOGIN=1 이면 운영 빌드에서도 로그인 OTP 가 화면(devCode)에 표시된다 → Zalo 없이 전화번호+OTP 로 시연 로그인.
# ⚠ 실운영에서는 반드시 미설정(끄기). 켜두면 인증코드가 화면에 노출된다. 실운영 로그인은 Zalo ZNS(OTP_LOGIN) 로 한다.
# DEMO_LOGIN=1

# ── AI 서류 추출기 (선택) ─────────────────────────────
# 키가 있으면 LLM 추출기(스캔·PDF·산문 읽기)를 쓰고, 없으면 텍스트만 옮기는 기본 추출기로 폴백.
# 사업자·모델은 문체부 협의 뒤 확정. 키는 .env 로만 주입한다(명령·설정에 평문 금지).
# VSP_LLM_API_KEY=              # 또는 ANTHROPIC_API_KEY
# VSP_LLM_MODEL=claude-sonnet-5
# VSP_LLM_BASE_URL=https://api.anthropic.com
# VSP_LLM_MAX_TOKENS=2048

# ── 알림 · 로그인 OTP (Zalo ZNS) ──────────────────────
# ★ 운영 필수 ★ 로그인 OTP 도 이 채널로 나간다. 운영(NODE_ENV=production)에서
#   어댑터가 없으면 로그인 시 OTP_NOT_CONFIGURED 로 실패한다 — 즉 아무도 로그인 못 한다.
#   (개발에서는 어댑터가 없어도 화면에 dev code 가 떠서 진행된다.)
# 토큰이 있으면 Zalo ZNS 어댑터로 발송, 없으면 개발에서만 콘솔로 폴백.
# ZNS 는 사전 승인된 템플릿(template_id)만 보내므로, 알림 코드→template_id 매핑을 준다.
#   → OTP_LOGIN 템플릿을 반드시 포함해야 로그인 코드가 나간다.
# ZALO_OA_TOKEN=
# ZALO_ZNS_ENDPOINT=https://business.openapi.zalo.me/message/template
# ZALO_ZNS_TEMPLATES={"OTP_LOGIN":"<template_id>","APPROVAL_PENDING":"<template_id>","SETTLEMENT_DUE":"<template_id>"}
# ZALO_ZNS_DEFAULT_TEMPLATE=

# ── 결제 게이트웨이 (VNPay · 선택) ────────────────────
# 코드·키가 있으면 VNPay 어댑터를, 없으면 개발에서만 모의(mock) 게이트웨이를 등록한다.
# 운영에서 미설정이면 결제 게이트웨이를 등록하지 않는다(모의로 실제 대금을 확정하지 않게).
# ★ 자금 원칙: 돈은 납부자→PG→협회(수취조직) 계좌로 직접. 우리 계좌를 거치지 않는다(시행령 52/2024).
#   실제 가맹점 코드·서명키는 수취 조직별로 다르며, 결제 라이선스·법률 검토가 선행이다(배포문서 F).
#   키는 .env/시크릿 매니저로만 주입(명령·설정 평문 금지). 노출 시 삭제가 아니라 재발급.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_RETURN_URL=https://<도메인>/api/payments/vnpay/return
